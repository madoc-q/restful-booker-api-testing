        {
          "name": "Create and Verify Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Booking was created with correct details\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.booking.firstname).to.eql(\"Alice\");",
                  "    pm.expect(jsonData.booking.lastname).to.eql(\"Johnson\");",
                  "    pm.expect(jsonData.booking.totalprice).to.eql(500);",
                  "});",
                  "",
                  "pm.environment.set(\"newbookingid\", pm.response.json().bookingid);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
